#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
cd "${repo_root}"

run_step() {
  local name="$1"
  shift
  local start="${SECONDS}"

  printf '\n==> %s\n' "${name}"
  "$@"
  printf '<== %s (%ss)\n' "${name}" "$((SECONDS - start))"
}

install_mise() {
  if [[ -x "${HOME}/.local/bin/mise" ]]; then
    return
  fi

  curl -fsSL https://mise.run | MISE_INSTALL_HELP=0 sh
}

configure_mise_path() {
  local profile="${HOME}/.bash_profile"
  local marker='# pi-doppelclaude mise shims'

  touch "${profile}"
  if grep -Fqx "${marker}" "${profile}"; then
    return
  fi

  cat >>"${profile}" <<'EOF'

# pi-doppelclaude mise shims
case ":${PATH}:" in
  *":${HOME}/.local/bin:"*) ;;
  *) export PATH="${HOME}/.local/bin:${PATH}" ;;
esac
case ":${PATH}:" in
  *":${HOME}/.local/share/mise/shims:"*) ;;
  *) export PATH="${HOME}/.local/share/mise/shims:${PATH}" ;;
esac
EOF
}

install_toolchain() {
  mise trust --yes "${repo_root}/mise.toml"
  mise install --yes --jobs 8
}

install_dependencies() {
  mise bootstrap --yes --quiet
}

install_claude() {
  local bundled_cli expected_version
  bundled_cli="$(find node_modules/@anthropic-ai -maxdepth 2 \
    -path '*/claude-agent-sdk-linux-*/claude' -type f -print -quit)"
  if [[ -z "${bundled_cli}" ]]; then
    printf 'Could not find the Claude Code binary bundled with the Agent SDK.\n' >&2
    return 1
  fi
  expected_version="$("${bundled_cli}" --version | awk 'NR == 1 { print $1 }')"

  if [[ "$(claude --version 2>/dev/null | awk 'NR == 1 { print $1 }' || true)" == "${expected_version}" ]]; then
    return
  fi

  curl -fsSL https://claude.ai/install.sh | bash -s -- "${expected_version}"
}

install_pi() {
  local expected_version
  expected_version="$(node -p "require('./node_modules/@earendil-works/pi-coding-agent/package.json').version")"

  if [[ "$(pi --version 2>/dev/null || true)" == "${expected_version}" ]]; then
    return
  fi

  npm install --global --no-fund --no-audit "@earendil-works/pi-coding-agent@${expected_version}"
  mise reshim
}

run_step 'mise' install_mise
configure_mise_path
export PATH="${HOME}/.local/share/mise/shims:${HOME}/.local/bin:${PATH}"
run_step 'project toolchain' install_toolchain
run_step 'project dependencies' install_dependencies
run_step 'Claude Code CLI' install_claude
run_step 'Pi CLI' install_pi

printf '\nOrb setup complete.\n'
