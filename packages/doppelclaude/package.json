{
  "name": "doppelclaude",
  "version": "0.14.19",
  "description": "Messages-shaped core for bridging clients to the Claude Agent SDK.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thurstonsand/pi-doppelclaude.git"
  },
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./*": {
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    }
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.319",
    "@anthropic-ai/sdk": "^1.6.0",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "cc-session-io": "^0.4.1",
    "partial-json": "0.1.7"
  },
  "peerDependencies": {
    "typebox": "*"
  }
}
