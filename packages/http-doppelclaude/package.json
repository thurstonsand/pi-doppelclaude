{
  "name": "http-doppelclaude",
  "version": "0.0.0",
  "description": "Anthropic Messages HTTP frontend for doppelclaude.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thurstonsand/pi-doppelclaude.git"
  },
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "main": "./dist/server.js",
  "types": "./dist/server.d.ts",
  "exports": {
    ".": {
      "types": "./dist/server.d.ts",
      "default": "./dist/server.js"
    },
    "./startup": {
      "types": "./dist/startup.d.ts",
      "default": "./dist/startup.js"
    }
  },
  "bin": {
    "doppelclaude-serve": "dist/cli.js"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.280",
    "@anthropic-ai/sdk": "^0.128.0",
    "doppelclaude": "0.0.0",
    "sharp": "^0.35.4",
    "typebox": "1.3.27"
  }
}
